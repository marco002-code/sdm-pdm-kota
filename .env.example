APP_NAME="SIM SDM PDM Kota Yogyakarta"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://sdm-pdm.muhijunior.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# BASIS DATA UTAMA: MySQL / MariaDB (HestiaCP)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adminmlc_sdm_db
DB_USERNAME=adminmlc_sdm
DB_PASSWORD=

# ------------------------------------------------------------------------------
# BASIS DATA ALTERNATIF: SQLite WAL Mode
# ------------------------------------------------------------------------------
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
# DB_BUSY_TIMEOUT=60000
# DB_JOURNAL_MODE=WAL
# DB_SYNCHRONOUS=NORMAL
# DB_TRANSACTION_MODE=IMMEDIATE

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=sdm_pdm_

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@pdmkotayogya.or.id"
MAIL_FROM_NAME="${APP_NAME}"
