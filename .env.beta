# ==============================================================================
# KONFIGURASI LINGKUNGAN VERSI BETA / PRODUCTION
# SIM SDM PDM KOTA YOGYAKARTA
# ==============================================================================
APP_NAME="SIM SDM PDM Kota Yogyakarta"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://sdm.pdmkotayogya.or.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Log harian dengan retensi otomatis (mencegah file log membengkak)
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# DATABASE OPTION 1: SQLite WAL Mode (Rekomendasi Default: Cepat & Mandiri)
# ------------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/sdm-pdm-kota/database/database.sqlite
DB_BUSY_TIMEOUT=60000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_TRANSACTION_MODE=IMMEDIATE

# ------------------------------------------------------------------------------
# DATABASE OPTION 2: MySQL / MariaDB (Jika menggunakan Database Server Dedicated)
# ------------------------------------------------------------------------------
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sdm_pdm_kota
# DB_USERNAME=sdm_user
# DB_PASSWORD=SecretStrongPassword123!

# ------------------------------------------------------------------------------
# SESI & COOKIE KEAMANAN
# ------------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------------
# ANTRIAN (QUEUE) & SISTEM ASINKRON
# Menggunakan driver database bawaan (tabel jobs, failed_jobs, job_batches)
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# CACHE SISTEM
# ------------------------------------------------------------------------------
CACHE_STORE=file
CACHE_PREFIX=sdm_pdm_

# ------------------------------------------------------------------------------
# PENGATURAN EMAIL (SMTP NOTIFIKASI)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=admin@pdmkotayogya.or.id
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@pdmkotayogya.or.id"
MAIL_FROM_NAME="${APP_NAME}"

